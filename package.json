{
  "name": "jdg-web-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "server": "node src/index.js",
    "server:dev": "nodemon src/index.js",
    "dev": "nodemon src/index.js",
    "start:static": "SERVE_STATIC=true node src/index.js",
    "seed": "node src/scripts/seed.js",
    "seed:clear": "node src/scripts/seed.js --clear",
    "seed:pages": "node src/scripts/seed.js",
    "build:admin-upload": "esbuild src/browser/admin-upload.js --bundle --minify --platform=browser --target=es2020 --outfile=public/admin-upload.js",
    "migrate:blob": "node src/scripts/migrate-content-to-blob.js",
    "migrate:blob:dry-run": "node src/scripts/migrate-content-to-blob.js --dry-run",
    "test": "node --test",
    "check": "npm run build:admin-upload && node --check src/index.js && node --check src/scripts/migrate-content-to-blob.js && npm test"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "mongoose": "^9.9.1",
    "multer": "^2.1.1",
    "sharp": "^0.34.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.9"
  }
}
