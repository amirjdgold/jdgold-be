# Server
PORT=3001
NODE_ENV=development

# MongoDB (required — no credentials are hardcoded in the app)
# Local example:
MONGODB_URI=mongodb://127.0.0.1:27017/jdg-web
# Atlas example:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/jdg-web?retryWrites=true&w=majority

# Required for PUT /api/content and /admin login (Authorization: Bearer <key> or x-api-key)
API_KEY=
# Vercel Blob read/write token. Keep server-side; never use a NEXT_PUBLIC_/VITE_ prefix.
# Browser uploads receive short-lived, pathname-scoped client tokens from the API.
BLOB_READ_WRITE_TOKEN=

# Comma-separated browser origins allowed to call this API.
# Use * to allow any origin, or leave empty to reflect the request Origin in local/dev.
# Local Vite default: http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# When true, serves FRONTEND_DIST (or ./public/spa) with SPA fallback.
# Prefer hosting the Vite app on Cloudflare Pages instead.
SERVE_STATIC=false
# FRONTEND_DIST=/absolute/path/to/frontend/dist

# Admin UI: http://localhost:3001/admin
# Sign in with the same value as API_KEY.
# With BLOB_READ_WRITE_TOKEN, media uploads go browser → Vercel Blob directly.
# Without it, local development retains the uploads/cms disk fallback.
